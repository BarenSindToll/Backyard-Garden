# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=<a-long-random-string>
NODE_ENV=development

# ── SMTP / transactional email ───────────────────────────────────────────────
# Email is OPTIONAL. If SMTP_USER or SMTP_PASS are left blank the backend
# starts normally; email sends are skipped and logged as warnings.
#
# ── Option A: Brevo (default) ────────────────────────────────────────────────
# Sign in to https://app.brevo.com → SMTP & API → SMTP.
# Click "Generate a new SMTP key" if you don't have one.
#   SMTP_HOST = smtp-relay.brevo.com  (default — can be omitted)
#   SMTP_PORT = 587                   (default — can be omitted)
#   SMTP_USER = the login shown on the SMTP page (e.g. 12ab3c456@smtp-brevo.com)
#   SMTP_PASS = the SMTP key shown there — NOT your Brevo account password
#   SMTP_FROM = a verified sender address (Settings → Senders & IP)
#
# ── Option B: Gmail ──────────────────────────────────────────────────────────
# Gmail requires 2-Step Verification to be enabled.
# Then create an App Password: myaccount.google.com → Security → App Passwords.
# Paste the 16-character App Password into SMTP_PASS without spaces.
#   SMTP_HOST = smtp.gmail.com
#   SMTP_PORT = 587
#   SMTP_USER = your-gmail-address@gmail.com
#   SMTP_PASS = xxxx xxxx xxxx xxxx   ← App Password (no spaces needed)
#   SMTP_FROM = your-gmail-address@gmail.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# ── Weather API (Visual Crossing) ─────────────────────────────────────────────
# https://www.visualcrossing.com/weather-api
VITE_WEATHER_API=<visual-crossing-api-key>
OPEN_WEATHER_API=<openweathermap-api-key>

# ── Anthropic (AI garden generation) ─────────────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# ── Permaculture AI service ───────────────────────────────────────────────────
# Set AI_ENABLED=true to activate live AI generation.
# When false or absent, the app uses a deterministic rule-based mock plan instead.
AI_ENABLED=false

# AI_PROVIDER selects which AI backend to use: anthropic | openai | ollama
AI_PROVIDER=anthropic

# AI_MODEL: model ID for the chosen provider (leave blank to use the provider default)
#   Anthropic: claude-opus-4-7 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
#   OpenAI:    gpt-4o | gpt-4o-mini | gpt-4-turbo
#   Ollama:    llama3 | mistral | gemma2 | (any model you have pulled)
AI_MODEL=claude-sonnet-4-6

# AI_API_KEY: optional override — takes precedence over the provider-specific key below
AI_API_KEY=

# OpenAI key (used when AI_PROVIDER=openai)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=<your-openai-api-key>

# Ollama local inference endpoint (used when AI_PROVIDER=ollama)
# Run `ollama serve` and pull a model first: `ollama pull llama3`
OLLAMA_URL=http://localhost:11434
